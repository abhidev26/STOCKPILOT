{
    "name": "stockpilot/stockpilot-360",
    "description": "StockPilot - Smart Inventory & Supply Chain Management System (core PHP, MySQL)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "scripts": {
        "test": "php tests/run.php",
        "serve": "php -S localhost:8000 -t public public/index.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
