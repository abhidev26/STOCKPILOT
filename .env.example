# StockPilot environment template.
# Copy this file to ".env" and edit the values. NEVER commit ".env".

APP_NAME=StockPilot
APP_ENV=local
# true shows detailed errors (local only). Use false in production.
APP_DEBUG=true
APP_URL=http://localhost/stockpilot-360
APP_TIMEZONE=Asia/Kolkata

# Database (XAMPP defaults: user "root" with an empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stockpilot
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
